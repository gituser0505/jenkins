@echo off
setlocal
REM === Define wallpaper path ===
set WALLPAPER=\\envizionstudios.local\SYSVOL\envizionstudios.local\Wallpapers\company_whitebg.jpg

REM === Update default profile (logon screen + new users) ===
reg add "HKU\.DEFAULT\Control Panel\Desktop" /v Wallpaper /t REG_SZ /d "%WALLPAPER%" /f
reg add "HKU\.DEFAULT\Control Panel\Desktop" /v WallpaperStyle /t REG_SZ /d 4 /f
reg add "HKU\.DEFAULT\Control Panel\Desktop" /v TileWallpaper /t REG_SZ /d 0 /f

REM === Apply to all loaded user profiles (domain + local) ===
for /f "tokens=3" %%a in ('reg query HKU') do (
    echo Processing %%a
    if /I not "%%a"=="S-1-5-18" if /I not "%%a"=="S-1-5-19" if /I not "%%a"=="S-1-5-20" (
        reg add "HKU\%%a\Control Panel\Desktop" /v Wallpaper /t REG_SZ /d "%WALLPAPER%" /f
        reg add "HKU\%%a\Control Panel\Desktop" /v WallpaperStyle /t REG_SZ /d 4 /f
        reg add "HKU\%%a\Control Panel\Desktop" /v TileWallpaper /t REG_SZ /d 0 /f
    )
)

REM === Force wallpaper refresh for all sessions ===
for /f "tokens=1" %%i in ('qwinsta ^| find "Active"') do (
    echo Refreshing wallpaper for session %%i
    rundll32.exe user32.dll,UpdatePerUserSystemParameters
)

endlocal
exit /b 0